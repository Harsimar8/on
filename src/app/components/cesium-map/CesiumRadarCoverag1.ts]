import * as Cesium from "cesium";

export interface Zone3DConfig {
    name: string;
    maxRange: number;       // Max range in meters (radius of this zone's ring)
    ceilingHeight: number;  // Thickness of this zone's coverage band, in meters,
                             // measured ABOVE the locally-visible floor (not
                             // above the radar's own base altitude). This is
                             // what makes the zone terrain-aware: the "roof"
                             // rises and falls with the ground/shadow floor
                             // beneath it instead of being a flat disc.
    color: Cesium.Color;
    wallAlpha: number;
    capAlpha: number;
}

export interface Radar3DOptions {
    longitude: number;
    latitude: number;
    antennaMastHeight?: number; // Height of antenna above ground (e.g. 25m)
    numAzimuths?: number;       // Number of azimuth rays (144 = every 2.5 degrees)
    zones?: Zone3DConfig[];
}

export class Cesium3DRadarCoverage {
    public static readonly DEFAULT_3D_ZONES: Zone3DConfig[] = [
        {
            name: "Low-Altitude (Green)",
            maxRange: 5000,
            ceilingHeight: 400, // 400m-thick band above the local floor
            color: Cesium.Color.fromCssColorString("#10B981"),
            wallAlpha: 0.35,
            capAlpha: 0.25
        },
        {
            name: "Mid-Altitude (Yellow)",
            maxRange: 16000,
            ceilingHeight: 900,
            color: Cesium.Color.fromCssColorString("#F59E0B"),
            wallAlpha: 0.30,
            capAlpha: 0.20
        },
        {
            name: "High-Altitude (Red/Pink)",
            maxRange: 20000,
            ceilingHeight: 1600,
            color: Cesium.Color.fromCssColorString("#EF4444"),
            wallAlpha: 0.25,
            capAlpha: 0.15
        }
    ];

    // Maximum allowed line-of-sight obstruction angle (radians). tan(60deg) ~= 1.73.
    // Without this cap, one nearby ridge could make the "shadow floor" climb
    // without bound at long range.
    private static readonly MAX_SLOPE = 1.73;

    // Sanity clamp: the visible floor can never be pushed more than this many
    // meters above the RADAR'S OWN ground level, no matter how extreme the
    // shadowing math gets at long range. Prevents absurd runaway heights.
    private static readonly MAX_FLOOR_ABOVE_RADAR_GROUND = 6000;

    // How many neighboring terrain samples (along a single ray) get averaged
    // together to suppress single-sample DEM noise.
    private static readonly SMOOTH_WINDOW = 3;

    // How many neighboring RAYS get averaged together (circular, wrap-around)
    // to stop adjacent rays from disagreeing sharply and creating jagged cuts.
    private static readonly ANGULAR_SMOOTH_RADIUS = 3;

    /**
     * Builds terrain-aware volumetric radar coverage zones.
     *
     * Each zone is a ring out to a fixed `maxRange`. At every azimuth, the
     * "floor" of the zone is either the local terrain height, or higher if
     * an obstruction closer to the radar blocks line-of-sight (a radar
     * shadow) - never dropping below the true visible line. The "roof" of
     * the zone is always `ceilingHeight` meters ABOVE that floor, so the
     * whole shell drapes over terrain like a raised canopy instead of being
     * a flat plane fixed to the radar's own elevation.
     */
    static async create3DRadarZones(
        viewer: Cesium.Viewer,
        terrainProvider: Cesium.TerrainProvider,
        options: Radar3DOptions
    ): Promise<Cesium.Entity[]> {
        const {
            longitude,
            latitude,
            antennaMastHeight = 25,
            numAzimuths = 144,
            zones = this.DEFAULT_3D_ZONES
        } = options;

        const maxOverallRange = Math.max(...zones.map(z => z.maxRange));
        const stepMeters = 250;
        const stepsPerRay = Math.ceil(maxOverallRange / stepMeters);

        // 1. Collect points for terrain query
        const cartographics: Cesium.Cartographic[] = [];
        const radarCenter = Cesium.Cartographic.fromDegrees(longitude, latitude);
        cartographics.push(radarCenter);

        for (let a = 0; a < numAzimuths; a++) {
            const azimuthRad = (a / numAzimuths) * Cesium.Math.TWO_PI;

            for (let s = 1; s <= stepsPerRay; s++) {
                const dist = Math.min(s * stepMeters, maxOverallRange);
                const { lon, lat } = this.destinationCoordinate(longitude, latitude, dist, azimuthRad);
                cartographics.push(Cesium.Cartographic.fromDegrees(lon, lat));
            }
        }

        // Fast, camera-independent terrain sampling
        try {
            await Cesium.sampleTerrain(terrainProvider, 11, cartographics);
        } catch {
            try {
                await Cesium.sampleTerrain(terrainProvider, 9, cartographics);
            } catch {
                for (const c of cartographics) {
                    const h = viewer.scene.globe.getHeight(c);
                    if (h !== undefined) c.height = h;
                }
            }
        }

        const groundAltitude = cartographics[0].height || 0;
        const radarOriginAlt = groundAltitude + antennaMastHeight;
        const maxFloorAlt = groundAltitude + this.MAX_FLOOR_ABOVE_RADAR_GROUND;

        // 2. Per-ray floor profile: for each ray, the "floor" (locally visible
        // lowest altitude, accounting for shadowing) sampled at each zone's
        // own maxRange distance.
        interface AzimuthProfile {
            zoneFloors: number[];      // one floor height per zone, at that zone's maxRange
            zoneRawTerrain: number[];  // unsmoothed terrain height at that same distance, used as a floor safety clamp
        }

        const profiles: AzimuthProfile[] = [];

        for (let a = 0; a < numAzimuths; a++) {
            const rayStartIndex = 1 + a * stepsPerRay;

            // Raw terrain heights for this ray
            const rawTerrainForRay: number[] = [];
            for (let s = 1; s <= stepsPerRay; s++) {
                const sample = cartographics[rayStartIndex + s - 1];
                rawTerrainForRay.push(sample?.height ?? groundAltitude);
            }

            // Smooth along the ray to suppress single-sample DEM noise
            // (used for the slope/shadow calculation only).
            const smoothedTerrainForRay: number[] = rawTerrainForRay.map((_, i) => {
                const lo = Math.max(0, i - Math.floor(this.SMOOTH_WINDOW / 2));
                const hi = Math.min(rawTerrainForRay.length - 1, i + Math.floor(this.SMOOTH_WINDOW / 2));
                let sum = 0;
                for (let k = lo; k <= hi; k++) sum += rawTerrainForRay[k];
                return sum / (hi - lo + 1);
            });

            let maxSlope = -Infinity;
            const shadowHeightAtDist: number[] = [];
            const terrainHeightAtDist: number[] = [];

            for (let s = 1; s <= stepsPerRay; s++) {
                const dist = Math.min(s * stepMeters, maxOverallRange);
                const terrainH = smoothedTerrainForRay[s - 1];
                terrainHeightAtDist.push(terrainH);

                const earthDrop = (dist * dist) / (2 * 6378137);

                const slope = (terrainH + earthDrop - radarOriginAlt) / dist;
                if (slope > maxSlope) {
                    maxSlope = slope;
                }
                if (maxSlope > this.MAX_SLOPE) {
                    maxSlope = this.MAX_SLOPE;
                }

                const shadowAlt = radarOriginAlt + dist * maxSlope - earthDrop;
                shadowHeightAtDist.push(shadowAlt);
            }

            const getHeightsAtDist = (targetDist: number) => {
                const idx = Math.min(Math.max(1, Math.round(targetDist / stepMeters)), stepsPerRay) - 1;
                return {
                    shadowH: shadowHeightAtDist[idx] ?? groundAltitude,
                    terrainH: terrainHeightAtDist[idx] ?? groundAltitude
                };
            };

            // Floor for each zone, evaluated at that zone's own maxRange
            const zoneFloors = zones.map(zone => {
                const h = getHeightsAtDist(zone.maxRange);
                const floor = Math.max(h.terrainH, h.shadowH);
                return Math.min(floor, maxFloorAlt); // sanity clamp
            });

            // Raw (unsmoothed) terrain height at each zone's range - used later
            // as a floor safety clamp so smoothing can never push the drawn
            // floor below the real ground surface (which would get hidden by
            // Cesium's terrain depth test, looking like the coverage
            // "disappears" over hills/peaks).
            const zoneRawTerrain = zones.map(zone => {
                const idx = Math.min(Math.max(1, Math.round(zone.maxRange / stepMeters)), stepsPerRay) - 1;
                return rawTerrainForRay[idx] ?? groundAltitude;
            });

            profiles.push({ zoneFloors, zoneRawTerrain });
        }

        // 3. Angular smoothing: average each ray's floor with its neighbors
        // (circular, wrap-around) so adjacent rays don't disagree sharply and
        // create jagged cuts across valleys/ridges.
        for (let zIdx = 0; zIdx < zones.length; zIdx++) {
            const raw = profiles.map(p => p.zoneFloors[zIdx]);
            for (let i = 0; i < numAzimuths; i++) {
                let sum = 0, count = 0;
                for (let k = -this.ANGULAR_SMOOTH_RADIUS; k <= this.ANGULAR_SMOOTH_RADIUS; k++) {
                    const idx = (i + k + numAzimuths) % numAzimuths;
                    sum += raw[idx];
                    count++;
                }
                const smoothedFloor = sum / count;

                // FIX: never let smoothing push this ray's floor below the
                // REAL, unsmoothed ground height directly beneath it - that
                // was causing the wall/cap to sink under the terrain mesh
                // and get hidden by the depth test right over hill peaks.
                profiles[i].zoneFloors[zIdx] = Math.max(smoothedFloor, profiles[i].zoneRawTerrain[zIdx]);
            }
        }

        const createdEntities: Cesium.Entity[] = [];

        // 4. Build the terrain-draped shells, largest zone first so smaller
        // zones render on top.
        for (let zIdx = zones.length - 1; zIdx >= 0; zIdx--) {
            const zone = zones[zIdx];

            const wallTopCartesians: Cesium.Cartesian3[] = [];
            const wallBottomHeights: number[] = [];
            const capCartesians: Cesium.Cartesian3[] = [];

            for (let a = 0; a < numAzimuths; a++) {
                const azimuthRad = (a / numAzimuths) * Cesium.Math.TWO_PI;
                const floor = profiles[a].zoneFloors[zIdx];

                // The roof is always ceilingHeight meters ABOVE the local
                // floor - this is what makes it drape over terrain instead
                // of being a flat plane fixed to the radar's own elevation.
                const roofHeight = floor + zone.ceilingHeight;

                const { lon, lat } = this.destinationCoordinate(
                    longitude,
                    latitude,
                    zone.maxRange,
                    azimuthRad
                );

                const topPos = Cesium.Cartesian3.fromDegrees(lon, lat, roofHeight);
                wallTopCartesians.push(topPos);
                wallBottomHeights.push(floor);
                capCartesians.push(topPos);
            }

            // Close wall loop
            wallTopCartesians.push(wallTopCartesians[0]);
            wallBottomHeights.push(wallBottomHeights[0]);

            // A. Terrain-draped vertical curtain wall (outer boundary of the ring)
            const wallEntity = viewer.entities.add({
                name: `${zone.name} 3D Wall`,
                wall: {
                    positions: wallTopCartesians,
                    minimumHeights: wallBottomHeights,
                    material: zone.color.withAlpha(zone.wallAlpha),
                    outline: true,
                    outlineColor: zone.color.withAlpha(0.9),
                    outlineWidth: 2
                }
            });
            createdEntities.push(wallEntity);

            // B. Terrain-draped roof - perPositionHeight lets each vertex
            // keep its own baked-in height (from topPos above) instead of
            // being forced onto one flat plane, so the roof follows terrain.
            const capEntity = viewer.entities.add({
                name: `${zone.name} Top Cap`,
                polygon: {
                    hierarchy: new Cesium.PolygonHierarchy(capCartesians),
                    perPositionHeight: true,
                    material: zone.color.withAlpha(zone.capAlpha),
                    outline: true,
                    outlineColor: zone.color.withAlpha(0.85)
                }
            });
            createdEntities.push(capEntity);
        }

        return createdEntities;
    }

    private static destinationCoordinate(
        lonDeg: number,
        latDeg: number,
        distMeters: number,
        bearingRad: number
    ): { lon: number; lat: number } {
        const R = 6378137.0;
        const dByR = distMeters / R;
        const lat1 = Cesium.Math.toRadians(latDeg);
        const lon1 = Cesium.Math.toRadians(lonDeg);

        const lat2 = Math.asin(
            Math.sin(lat1) * Math.cos(dByR) +
            Math.cos(lat1) * Math.sin(dByR) * Math.cos(bearingRad)
        );

        const lon2 = lon1 + Math.atan2(
            Math.sin(bearingRad) * Math.sin(dByR) * Math.cos(lat1),
            Math.cos(dByR) - Math.sin(lat1) * Math.sin(lat2)
        );

        return {
            lon: Cesium.Math.toDegrees(lon2),
            lat: Cesium.Math.toDegrees(lat2)
        };
    }
}